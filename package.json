{
  "name": "eat-outside-nyc",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A map of NYC establishments participating in the Dining Out NYC program, built from NYC Open Data.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:data": "python3 -m pytest tests/python -q",
    "test:smoke": "vitest run tests/smoke",
    "test:a11y": "vitest run tests/contrast.test.ts tests/layout.test.ts tests/axe.test.tsx",
    "data:fetch": "python3 scripts/fetch_data.py",
    "data:inspect": "python3 scripts/inspect_data.py",
    "data:clean": "python3 scripts/clean_data.py",
    "data:validate": "python3 scripts/validate_data.py",
    "data:refresh": "python3 scripts/refresh_data.py",
    "data:storefronts:refresh": "python3 scripts/storefronts/refresh.py",
    "data:storefronts:inspect": "python3 scripts/storefronts/inspect.py",
    "data:storefronts:validate": "python3 scripts/storefronts/validate.py",
    "verify": "npm run lint && npm run test && npm run build && npm run data:validate -- --strict && npm run data:storefronts:validate -- --strict && npm run test:data"
  },
  "dependencies": {
    "maplibre-gl": "^5.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.13.0",
    "dom-accessibility-api": "^0.7.1",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vite": "^6.0.11",
    "vitest": "^3.0.4"
  }
}
