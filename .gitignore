node_modules/
dist/
coverage/
*.local
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.log

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Raw source snapshots are reproducible via `npm run data:fetch`.
# Keep the directory, ignore the payload (see docs/data-pipeline.md).
# `**` matters: the walk pipeline nests its snapshots one level deeper
# (data/raw/walk/*.json, ~9 MB), and `data/raw/*.json` does NOT match those.
data/raw/**/*.json
!data/raw/.gitkeep
!**/.gitkeep

# Storefront Pulse keeps its SQLite source cache locally; it is reproducible
# and must never be published or committed.
data/cache/storefronts/
data/raw/storefronts/

# Test/build scratch
.vitest/
test-results/

# Implementation plans. Working documents for one change, written before the code and
# superseded by it: they name line numbers, test counts and helper signatures that drift the
# moment the work lands, and every one of those claims was wrong in at least one case when
# the plan it came from was executed. A checked-in plan is a second source of truth that
# disagrees with the code it describes. The decisions that outlive a change belong in
# docs/adr/ (see docs/decisions.md); the reasoning for a fix belongs in the commit and the
# comment above the code it explains.
docs/plans/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
